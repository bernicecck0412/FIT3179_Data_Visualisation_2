{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700,
  "height": 400,
  "title": "Malaysian States GDP vs Population",
  "data": {
    "url": "https://raw.githubusercontent.com/bernicecck0412/FIT3179_Data_Visualisation_2/refs/heads/main/data/Malaysia_Population_and_GDP.csv"
  },
  "params": [
    {
      "name": "Population_Above",
      "value": 0,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 8000000,
        "step": 100000,
        "name": "Minimum Population: "
      }
    },
    {
      "name": "Year_selection",
      "bind": {
        "input": "select",
        "options": [null, 2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024],
        "labels": ["Show All Years", "2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024"],
        "name": "Year Selection: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.GDP > 0"},
    {"filter": "datum.Population > Population_Above"},
    {
      "filter": "Year_selection == null || datum.Year == Year_selection"
    }
  ],
  "encoding": {
    "x": {
      "field": "Population",
      "type": "quantitative",
      "title": "Population",
      "axis": {"tickCount": 7},
      "scale": {"domain": [0, 8000000]}
    },
    "y": {
      "field": "GDP",
      "type": "quantitative",
      "title": "Total GDP (RM)",
      "axis": {"tickCount": 6},
      "scale": {"domain": [0, 450000]}
    }
  },
  "layer": [
    {
      "mark": "circle",
      "encoding": {
        "color": {
          "field": "State",
          "type": "nominal",
          "title": "State",
          "scale": {
            "domain": ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Penang", "Sabah", "Sarawak", "Selangor", "Terengganu", "Kuala Lumpur", "Labuan"],
            "range": ["#615FFF",  "#FFD230", "#A65F1B", "#36BBA7", "#1C398E", "#21BCFF", "#AD46FF", "#FB64B6", "#FFA1AD",  "#90A1B9", "#79716B", "#FF692A", "#B8E6FE",  "#1A7595", "#7CCF35"]
        }
        },
        "opacity": {"value": 0.8},
        "tooltip": [
          {"field": "State", "type": "nominal"},
          {"field": "Year", "type": "quantitative"},
          {"field": "Population", "type": "quantitative", "format": ","},
          {"field": "GDP", "type": "quantitative", "format": ","}
        ]
      }
    }
  ]
}