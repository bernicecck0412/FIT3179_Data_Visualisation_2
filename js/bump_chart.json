{
    "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
    "width": 700,
    "height": 400,
    "data": {
        "url": "https://raw.githubusercontent.com/bernicecck0412/FIT3179_Data_Visualisation_2/refs/heads/main/data/Ranking_GDP_Per_Capita_Malaysia_States.csv",
        "format": {"type": "csv"}
    },
    "transform": [
        {
            "sort": [{"field": "GDP", "order": "descending"}],
            "window": [{"op": "rank", "as": "rank"}],
            "groupby": ["Year"]
        },
        {
            "lookup": "State",
            "from": {
                "data": {
                    "url": "https://raw.githubusercontent.com/bernicecck0412/FIT3179_Data_Visualisation_2/refs/heads/main/data/Flags.csv"
                },
                "key": "State",
                "fields": ["Icon"]
            }
        }
    ],
    "encoding": {
        "x": {
            "field": "Year",
            "type": "ordinal",
            "sort": ["2015", "2016", "2017", "2018", "2019", "2020", "2021", "2022", "2023", "2024"],
            "title": "Year",
            "axis": {
                "grid": true,
                "domain": false,
                "ticks": false,
                "offset": 20,
                "labelAngle": 0
            }
        },
        "y": {
            "field": "Rank",
            "type": "quantitative",
            "sort": "descending",
            "title": "Rank",
            "scale": {"domainMin": 1},
            "axis": {
                "grid": true,
                "domain": false,
                "ticks": false,
                "offset": -10
            }
        },
        "tooltip": [
            {"field": "State", "type": "nominal"},
            {"field": "GDP", "type": "quantitative", "format": ",.0f"},
            {"field": "Rank", "type": "quantitative"}
        ],
        "color": {
                    "field": "State",
                    "type": "nominal",
                    "title": "State",
                    "legend": null,
                    "scale": {
                        "domain": ["Johor", "Kedah", "Kelantan", "Melaka", "Negeri Sembilan", "Pahang", "Perak", "Perlis", "Pulau Pinang", "Sabah", "Sarawak", "Selangor", "Terengganu", "Kuala Lumpur", "Labuan"],
                        "range": ["lightgrey",  "lightgrey", "lightgrey", "lightgrey", "lightgrey", "lightgrey", "lightgrey", "lightgrey", "#FFA1AD",  "lightgrey", "lightgrey", "lightgrey", "lightgrey",  "#25A9E5", "#A65F1B"]
                    }
                }
    },
    "layer": [
        {
            "mark": {
                "type": "line",
                "size": 5,
                "point": {
                    "filled": true,
                    "size": 80,
                    "strokeWidth": 5
                }
            },
            "encoding": {"color": {"field": "State"}, "opacity": {"value": 0.8}}
        },
        {
            "mark": {"type": "image", "width": 40, "height": 20, "tooltip": true},
            "transform": [{"filter": "datum.Year == 2015 || datum.Year == 2024"}],
            "encoding": {"url": {"field": "Icon", "type": "nominal"}}
        },
        {
            "mark": {
                "type": "text",
                "align": "left",
                "dx": 50,
                "dy": -10, 
                "fontSize": 11,
                "fontWeight": "bold"
            },
            "encoding": {
                "text": {"field": "State"},
                "color": {
                    "field": "State",
                    "type": "nominal",
                    "scale": {
                        "domain": ["Kuala Lumpur", "Labuan", "Pulau Pinang"],
                        "range": ["#1A7595", "#7CCF35", "#79716B", "#FFA1AD"]
                    }
                }
            },
            "transform": [
                {
                    "filter": "datum.rank <= 3 && datum.Year == '2015'"
                }
            ]  
        }
    ]
}