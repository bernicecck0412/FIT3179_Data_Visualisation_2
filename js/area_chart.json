{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "data": {
    "url": "https://raw.githubusercontent.com/bernicecck0412/FIT3179_Data_Visualisation_2/refs/heads/main/data/GDP_Economic_Activity.csv",
    "format": {"type": "csv"}
  },
  "vconcat": [
    {
      "width": 680,
      "height": 300,
      "transform": [
        {
          "fold": ["Agriculture", "Mining and Quarrying", "Manufacturing", "Construction"],
          "as": ["Sector", "GDP_Value"]
        },
        {
          "calculate": "parseFloat(replace(datum.GDP_Value, ',', ''))",
          "as": "GDP_Numeric"
        }
      ],
      "mark": {"type": "area", "tooltip": true, "line": true},
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "scale": {"domain": {"param": "brush"}},
          "axis": {"title": "", "tickCount": 10}
        },
        "y": {
          "field": "GDP_Numeric",
          "type": "quantitative",
          "title": "GDP (RM Million)",
          "axis": {"format": ",.0f"}
        },
        "color": {
          "field": "Sector",
          "type": "nominal",
          "scale": {
            "domain": ["Agriculture", "Mining and Quarrying", "Manufacturing", "Construction"],
            "range": ["#FFF085", "#D1D5DC", "#70D897", "#FFA1AD", "#b3b3ff", "#FFB86A"]
          }
        },
        "tooltip": [
          {"field": "Date", "type": "temporal", "title": "Date"},
          {"field": "Sector", "type": "nominal", "title": "Sector"},
          {"field": "GDP_Numeric", "type": "quantitative", "title": "GDP (RM Million)", "format": ",.0f"}
        ]
      }
    },
    {
      "width": 680,
      "height": 80,
      "transform": [
        {
          "fold": ["Agriculture", "Mining and Quarrying", "Manufacturing", "Construction"],
          "as": ["Sector", "GDP_Value"]
        },
        {
          "calculate": "parseFloat(replace(datum.GDP_Value, ',', ''))",
          "as": "GDP_Numeric"
        }
      ],
      "mark": {"type": "area", "opacity": 0.8},
      "params": [
        {
          "name": "brush",
          "select": {"type": "interval", "encodings": ["x"]}
        }
      ],
      "encoding": {
        "x": {
          "field": "Date",
          "type": "temporal",
          "axis": {"title": "Drag to select time range"}
        },
        "y": {
          "field": "GDP_Numeric",
          "type": "quantitative",
          "axis": {"tickCount": 3, "grid": false, "title": ""}
        },
        "color": {
          "field": "Sector",
          "type": "nominal",
          "scale": {
            "domain": ["Agriculture", "Mining and Quarrying", "Manufacturing", "Construction"],
            "range": ["#FFF085", "#D1D5DC", "#70D897", "#FFA1AD", "#b3b3ff", "#FFB86A"]
          },
          "legend": {
            "orient": "bottom",
            "title": "Economic Sector"
          }
        }
      }
    }
  ]
}